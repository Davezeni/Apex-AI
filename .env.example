# Apex AI — environment template
# Copy to `.env` and fill in values. NEVER commit `.env`.
# All values below are placeholders; the app runs on local Ollama alone
# with no keys if none are provided.

# --- Model providers (optional; local Ollama works with none) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Optional: Tavily web search (leave empty for free DuckDuckGo) ---
TAVILY_API_KEY=

# --- Optional: GitHub (use a fine-grained PAT, not a classic token) ---
GITHUB_TOKEN=

# --- Agent tuning ---
MAX_ITERATIONS=12
COOLDOWN_SECONDS=60
